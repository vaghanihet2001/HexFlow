# ─────────────────────────────────────────────
# HexFlow — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Port for the Vite dev server
FRONTEND_PORT=5000

# Allowed hosts (comma-separated)
# Use 'localhost,127.0.0.1' for local dev
# Use your domain for production
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
# VITE_ALLOWED_HOSTS=hexflow.hexverce.in,hexflow.onrender.com

# ─────────────────────────────────────────────
# 🔐 Firebase Authentication (OPTIONAL)
# ─────────────────────────────────────────────
# Set VITE_ENABLE_AUTH=true to show a login screen.
# Set VITE_ENABLE_AUTH=false (default) to skip login entirely.
# When false, all VITE_FIREBASE_* variables below are ignored
# and do NOT need to be filled in.
VITE_ENABLE_AUTH=false

# Firebase project credentials
# Only required when VITE_ENABLE_AUTH=true
# Get these from: Firebase Console → Project Settings → Your Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
