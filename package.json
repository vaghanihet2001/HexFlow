{
  "name": "reactflow-playground",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "dotenv -e .env concurrently \"npm run start:frontend\" \"npm run start:backend\"",
    "start:backend": "dotenv -e .env node server.js",
    "start:frontend": "dotenv -e .env vite --host 0.0.0.0 --port $FRONTEND_PORT --force"
  },
  "dependencies": {
    "bootstrap": "^5.3.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dom-to-image": "^2.6.0",
    "dotenv-cli": "^7.3.0",
    "express": "^4.18.2",
    "firebase": "^11.10.0",
    "firebase-admin": "^12.7.0",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-bootstrap": "^2.8.0",
    "react-datepicker": "^8.10.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "reactflow": "^11.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^8.2.0",
    "vite": "^5.4.20"
  }
}
